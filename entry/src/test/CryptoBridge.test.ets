import { describe, it, expect } from '@ohos/hypium';
import { CryptoBridge } from '../main/ets/crypto/CryptoBridge';
import { CryptoUtil } from '../main/ets/crypto/CryptoUtil';
import { ImportService } from '../main/ets/services/ImportService';
import { Code } from '../main/ets/models/Code';
import { Utf8Strict } from '../main/ets/models/UriComponent';
import { CRYPTO_FIXTURES_JSON } from './FixturesData';

/**
 * Byte-level cross-implementation verification of the HarmonyOS libsodium
 * bridge (`libentecrypto.so`).
 *
 * The fixtures are generated by `tools/host-tests/gen-fixtures.mjs` using
 * libsodium — the same C library that backs upstream `ente_crypto_dart`. Every
 * fixture field is prefixed with its encoding ("hex:" or "base64:") and the
 * entry declares how it must be checked via its `verify` field:
 *
 *   re-encrypt : all randomness is recorded, so re-encrypting must reproduce
 *                the recorded ciphertext byte-for-byte.
 *   re-derive  : the value is a deterministic KDF output.
 *   decrypt    : the primitive is randomised (secretstream header,
 *                crypto_box_seal ephemeral key), so the recorded ciphertext is
 *                verified by DECRYPTING it.
 *
 * These tests need the native module, so they only run inside the packaged app
 * (DEVICE_REQUIRED). The same vectors are also executed headlessly by
 * `tools/host-tests/tests/20_crypto.test.mjs`.
 */
function fixtures(): Record<string, Record<string, Object>> {
  return JSON.parse(CRYPTO_FIXTURES_JSON) as Record<string, Record<string, Object>>;
}

/** Decodes a "hex:<...>" / "base64:<...>" fixture field. */
function field(v: Object): Uint8Array {
  const s = v as string;
  if (s.startsWith('hex:')) {
    return hexToBytes(s.substring(4));
  }
  if (s.startsWith('base64:')) {
    return CryptoUtil.base642bin(s.substring(7));
  }
  throw new Error('fixture field is not encoding-tagged');
}

function hexToBytes(hex: string): Uint8Array {
  const out = new Uint8Array(hex.length / 2);
  for (let i = 0; i < out.length; i++) {
    out[i] = parseInt(hex.substring(i * 2, i * 2 + 2), 16);
  }
  return out;
}

function bytesToHex(bytes: Uint8Array): string {
  let out = '';
  for (let i = 0; i < bytes.length; i++) {
    const h = bytes[i].toString(16);
    out += h.length === 1 ? '0' + h : h;
  }
  return out;
}

function utf8Decode(bytes: Uint8Array): string {
  return Utf8Strict.decode(Array.from(bytes));
}

export default function cryptoBridgeTest() {
  describe('CryptoBridge — libsodium parity vectors (host-generated)', () => {
    it('argon2id derives the reference key', 0, () => {
      const v = fixtures()['argon2id'];
      const key = CryptoBridge.cryptoPwHash(
        field(v['password']), field(v['salt']),
        v['opsLimit'] as number, v['memLimit'] as number);
      expect(bytesToHex(key)).assertEqual((v['key'] as string).substring(4));
    });

    it('secretbox easy/open reproduces and opens the reference ciphertext', 0, () => {
      const v = fixtures()['secretbox'];
      const key = field(v['key']);
      const nonce = field(v['nonce']);
      const msg = field(v['message']);
      const ct = CryptoBridge.secretboxEasy(msg, nonce, key);
      expect(bytesToHex(ct)).assertEqual((v['ct'] as string).substring(4));
      expect(bytesToHex(CryptoBridge.secretboxOpenEasy(ct, nonce, key)))
        .assertEqual(bytesToHex(msg));
    });

    it('secretstream single-message roundtrip has the upstream shape', 0, () => {
      const key = CryptoUtil.generateKey();
      const msg = utf8Encode('this is a secret otpauth url');
      const pair = CryptoBridge.secretstreamEncrypt(key, msg);
      expect(pair[0].length).assertEqual(24);            // HEADERBYTES
      expect(pair[1].length).assertEqual(msg.length + 17); // ABYTES
      expect(utf8Decode(CryptoBridge.secretstreamDecrypt(key, pair[0], pair[1])))
        .assertEqual('this is a secret otpauth url');
    });

    it('secretstream decrypts the host-generated reference ciphertext', 0, () => {
      const v = fixtures()['secretstream'];
      const plain = CryptoBridge.secretstreamDecrypt(
        field(v['key']), field(v['header']), field(v['ct']));
      expect(utf8Decode(plain)).assertEqual(utf8Decode(field(v['message'])));
    });

    it('kdf recipe gives the reference subkey and deriveLoginKey truncates to 16', 0, async () => {
      const v = fixtures()['kdf'];
      const key = field(v['key']);
      const sub32 = CryptoBridge.cryptoKdfDeriveFromKey(32, 1, 'loginctx', key);
      expect(bytesToHex(sub32)).assertEqual((v['subkey32'] as string).substring(4));
      expect(bytesToHex(sub32.subarray(0, 16))).assertEqual((v['subkey16'] as string).substring(4));
      const loginKey = await CryptoUtil.deriveLoginKey(key);
      expect(loginKey.length).assertEqual(16);
      expect(bytesToHex(loginKey)).assertEqual((v['subkey16'] as string).substring(4));
    });

    it('box seal opens the reference sealed box and round-trips', 0, () => {
      const v = fixtures()['boxSeal'];
      const pk = field(v['publicKey']);
      const sk = field(v['secretKey']);
      const msg = field(v['message']);
      expect(bytesToHex(CryptoBridge.boxSealOpen(field(v['ct']), pk, sk)))
        .assertEqual(bytesToHex(msg));
      const reSealed = CryptoBridge.boxSeal(msg, pk);
      expect(reSealed.length).assertEqual(msg.length + 48); // SEALBYTES
      expect(bytesToHex(CryptoBridge.boxSealOpen(reSealed, pk, sk))).assertEqual(bytesToHex(msg));
    });

    it('auth key wrap: secretbox wrap/unwrap with master key', 0, () => {
      const v = fixtures()['authKeyWrap'];
      const dataKey = CryptoUtil.decryptSync(
        field(v['wrapped']), field(v['masterKey']), field(v['nonce']));
      expect(bytesToHex(dataKey)).assertEqual((v['dataKey'] as string).substring(4));
      const rewrapped = CryptoUtil.encryptSync(dataKey, field(v['masterKey']));
      expect(bytesToHex(CryptoUtil.decryptSync(
        rewrapped.encryptedData as Uint8Array, field(v['masterKey']),
        rewrapped.nonce as Uint8Array))).assertEqual((v['dataKey'] as string).substring(4));
    });

    it('login recipe: password -> KEK -> loginKey -> masterKey', 0, async () => {
      const v = fixtures()['loginFlow'];
      const kek = await CryptoUtil.deriveKey(
        CryptoUtil.utf8Encode(v['password'] as string), field(v['kekSalt']),
        v['memLimit'] as number, v['opsLimit'] as number);
      expect(bytesToHex(kek)).assertEqual((v['kek'] as string).substring(4));
      const loginKey = await CryptoUtil.deriveLoginKey(kek);
      expect(bytesToHex(loginKey)).assertEqual((v['loginKey'] as string).substring(4));
      const masterKey = CryptoUtil.decryptSync(
        field(v['encryptedKey']), kek, field(v['keyDecryptionNonce']));
      expect(bytesToHex(masterKey)).assertEqual((v['masterKey'] as string).substring(4));
    });

    it('Ente encrypted export fixture decrypts to otpauth lines', 0, async () => {
      const v = fixtures()['enteExport'];
      const kdf = v['kdfParams'] as Record<string, Object>;
      const key = await CryptoUtil.deriveKey(
        CryptoUtil.utf8Encode(v['password'] as string), field(kdf['salt']),
        kdf['memLimit'] as number, kdf['opsLimit'] as number);
      const plain = await CryptoUtil.decryptData(
        field(v['encryptedData']), key, field(v['encryptionNonce']));
      const text = utf8Decode(plain);
      expect(text).assertEqual(v['plaintext'] as string);
      const codes: Code[] = ImportService.parsePlainText(text);
      expect(codes.length).assertEqual(3);
      expect(codes[0].issuer).assertEqual('GitHub');
      expect(codes[1].algorithm.toString()).assertEqual('sha256');
      expect(codes[2].type.toString()).assertEqual('hotp');
      expect(codes[2].counter).assertEqual(7);
    });

    it('session token encoding keeps the base64url alphabet AND padding', 0, () => {
      // Upstream stores base64UrlEncode(token) and sends it verbatim as
      // X-Auth-Token (base_configuration.dart:231,279; network.dart:133-136).
      // Note: a naive String.replace('+','-') only rewrites the FIRST match,
      // and stripping '=' padding both break the header value.
      const bytes = hexToBytes('fbfffefbfffe');
      expect(CryptoUtil.bin2base64(bytes, false)).assertEqual('+//++//+');
      expect(CryptoUtil.bin2base64(bytes, true)).assertEqual('-__--__-');
      expect(CryptoUtil.bin2base64(hexToBytes('ff'), false)).assertEqual('/w==');
      expect(CryptoUtil.bin2base64(hexToBytes('ff'), true)).assertEqual('_w==');
      // base642bin must accept both alphabets and missing padding (Dart parity).
      expect(bytesToHex(CryptoUtil.base642bin('-__--__-'))).assertEqual('fbfffefbfffe');
      expect(bytesToHex(CryptoUtil.base642bin('_w'))).assertEqual('ff');
      expect(bytesToHex(CryptoUtil.base642bin('/w=='))).assertEqual('ff');
    });
  });
}

function utf8Encode(s: string): Uint8Array {
  return CryptoUtil.utf8Encode(s);
}
